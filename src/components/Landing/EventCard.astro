---
import { getDictionary, resolveLocale } from "../../locales";

interface Props {
	title: string;
	href: string;
	date: string;
	location: string;
	organizer: string;
	rating: number;
	image: string;
	imageAlt: string;
}

const { title, href, date, location, organizer, rating, image, imageAlt } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const card = getDictionary(locale).events.card;

const ratingFormatter = new Intl.NumberFormat(locale, {
	minimumFractionDigits: 1,
	maximumFractionDigits: 1,
});

const fullStars = Math.floor(rating);
const hasHalf = rating - fullStars >= 0.25 && rating - fullStars < 0.75;
const filled = Array.from({ length: fullStars });
const halves = hasHalf ? [0] : [];
const empties = Array.from({ length: 5 - fullStars - (hasHalf ? 1 : 0) });
---

<article
	class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm transition-transform duration-300 ease-out hover:-translate-y-1 hover:shadow-md"
>
	<a href={href} class="bg-emperor-200 relative block aspect-[4/3] overflow-hidden">
		<img src={image} alt={imageAlt} loading="lazy" decoding="async" class="size-full object-cover" />
	</a>

	<div class="flex flex-1 flex-col gap-2 p-4">
		<h3 class="text-emperor-900 text-sm font-semibold">
			<a href={href} class="hover:text-ocean-600">{title}</a>
		</h3>
		<dl class="text-emperor-500 space-y-0.5 text-xs">
			<div><dt class="sr-only">{card.dateLabel}</dt><dd>{date}</dd></div>
			<div><dt class="sr-only">{card.placeLabel}</dt><dd>{location}</dd></div>
			<div>
				<dt class="sr-only">{card.organizerLabel}</dt>
				<dd>{card.byOrganizer(organizer)}</dd>
			</div>
		</dl>

		<div class="mt-2 flex items-center gap-2">
			<span class="text-emperor-700 text-xs font-medium">
				{ratingFormatter.format(rating)}
				{card.ratingSuffix}
			</span>
			<div class="flex items-center gap-0.5" aria-label={card.ratingAria(rating)}>
				{
					filled.map(() => (
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#FBBF24" class="size-4" aria-hidden="true">
							<path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.32.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .32-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
						</svg>
					))
				}
				{
					halves.map(() => (
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4" aria-hidden="true">
							<defs>
								<linearGradient id={`half-${title}`}>
									<stop offset="50%" stop-color="#FBBF24" />
									<stop offset="50%" stop-color="#E7E5E4" />
								</linearGradient>
							</defs>
							<path
								fill={`url(#half-${title})`}
								d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.32.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .32-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
							/>
						</svg>
					))
				}
				{
					empties.map(() => (
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="#E7E5E4"
							stroke-width="1.5"
							stroke-linejoin="round"
							class="size-4"
							aria-hidden="true"
						>
							<path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.32.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .32-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
						</svg>
					))
				}
			</div>
		</div>

		<div class="border-sand-200 mt-2 flex items-center gap-2 border-t pt-3">
			<button
				type="button"
				aria-label={card.shareAria(title)}
				class="text-emperor-400 hover:bg-sand-100 hover:text-emperor-700 rounded-full p-1.5 transition-colors"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-4"
					aria-hidden="true"
				>
					<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
					<polyline points="16 6 12 2 8 6"></polyline>
					<line x1="12" x2="12" y1="2" y2="15"></line>
				</svg>
			</button>
			<button
				type="button"
				aria-label={card.favoriteAria(title)}
				class="text-emperor-400 hover:bg-sand-100 hover:text-emperor-700 rounded-full p-1.5 transition-colors"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-4"
					aria-hidden="true"
				>
					<path
						d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
					></path>
				</svg>
			</button>
		</div>
	</div>
</article>
