---
import hero3 from "@assets/carousel-samples/hero-3.webp?url";
import hero4 from "@assets/carousel-samples/hero-4.webp?url";
import hero5 from "@assets/carousel-samples/hero-5.webp?url";
import hero6 from "@assets/carousel-samples/hero-6.webp?url";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, resolveLocale } from "../../locales";

interface Place {
	tag: string;
	name: string;
	href: string;
	src: string;
	alt: string;
}

const locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);
const tag = dict.explora.restaurantTag;

const tall: Place = {
	tag,
	name: dict.explora.places.elMexicano.name,
	href: getRelativeLocaleUrl(locale, "/restaurantes/el-mexicano"),
	src: hero3,
	alt: dict.explora.places.elMexicano.alt,
};

const wide: Place = {
	tag,
	name: dict.explora.places.theFishMarket.name,
	href: getRelativeLocaleUrl(locale, "/restaurantes/the-fish-market"),
	src: hero4,
	alt: dict.explora.places.theFishMarket.alt,
};

const small: Place[] = [
	{
		tag,
		name: dict.explora.places.palapaAntigua.name,
		href: getRelativeLocaleUrl(locale, "/restaurantes/palapa-antigua"),
		src: hero5,
		alt: dict.explora.places.palapaAntigua.alt,
	},
	{
		tag,
		name: dict.explora.places.elMiradorDelSur.name,
		href: getRelativeLocaleUrl(locale, "/restaurantes/el-mirador-del-sur"),
		src: hero6,
		alt: dict.explora.places.elMiradorDelSur.alt,
	},
];
---

<section class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
	<header class="mb-6">
		<h2 class="text-emperor-900 text-2xl font-bold tracking-tight sm:text-3xl">
			{dict.explora.heading}
		</h2>
	</header>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
		<a href={tall.href} class="group bg-emperor-200 relative block aspect-[4/5] overflow-hidden rounded-2xl shadow-sm md:row-span-2 md:aspect-auto">
			<img
				src={tall.src}
				alt={tall.alt}
				loading="lazy"
				decoding="async"
				class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
			/>
			<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
			<div class="absolute inset-x-0 bottom-0 p-5 transition-transform duration-300 ease-out group-hover:-translate-y-1">
				<span class="text-xs font-medium tracking-wider text-white/85 uppercase">{tall.tag}</span>
				<h3 class="mt-1 text-xl font-semibold text-white">{tall.name}</h3>
			</div>
		</a>

		<a href={wide.href} class="group bg-emperor-200 relative block aspect-[5/3] overflow-hidden rounded-2xl shadow-sm">
			<img
				src={wide.src}
				alt={wide.alt}
				loading="lazy"
				decoding="async"
				class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
			/>
			<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
			<div class="absolute inset-x-0 bottom-0 p-5 transition-transform duration-300 ease-out group-hover:-translate-y-1">
				<span class="text-xs font-medium tracking-wider text-white/85 uppercase">{wide.tag}</span>
				<h3 class="mt-1 text-xl font-semibold text-white">{wide.name}</h3>
			</div>
		</a>

		<div class="grid grid-cols-2 gap-4">
			{
				small.map((p) => (
					<a href={p.href} class="group bg-emperor-200 relative block aspect-[5/3] overflow-hidden rounded-2xl shadow-sm">
						<img
							src={p.src}
							alt={p.alt}
							loading="lazy"
							decoding="async"
							class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
						/>
						<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent" />
						<div class="absolute inset-x-0 bottom-0 p-4 transition-transform duration-300 ease-out group-hover:-translate-y-1">
							<span class="text-[10px] font-medium tracking-wider text-white/85 uppercase">{p.tag}</span>
							<h3 class="mt-1 text-base font-semibold text-white">{p.name}</h3>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
