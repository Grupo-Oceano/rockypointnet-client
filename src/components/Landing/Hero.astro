---
import { getDictionary, resolveLocale } from "../../locales";
import PartnersSlideshow from "../qwik/landing/PartnersSlideshow";

const locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);
---

<section class="relative z-10 mx-auto w-full max-w-7xl px-2 md:px-10 lg:px-12" aria-label={dict.hero.carouselAria}>
	<div class="relative overflow-hidden rounded-3xl shadow-sm" transition:name="hero-carousel">
		<PartnersSlideshow locale={locale} />
	</div>
</section>
