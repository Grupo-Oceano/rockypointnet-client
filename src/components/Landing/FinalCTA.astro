---
import hero2 from "@assets/carousel-samples/hero-2.webp?url";
import hero5 from "@assets/carousel-samples/hero-5.webp?url";
import { ArrowRight } from "@icons";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, resolveLocale } from "../../locales";

const locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);
---

<section class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8" aria-labelledby="cta-heading">
	<div class="grid items-center gap-10 md:grid-cols-2">
		<div class="relative h-90 sm:h-105">
			<div class="bg-emperor-200 absolute top-0 left-0 h-[78%] w-[78%] overflow-hidden rounded-2xl border-4 border-white shadow-md">
				<img src={hero5} alt={dict.finalCta.familyImageAlt} loading="lazy" decoding="async" class="size-full object-cover" />
			</div>
			<div class="bg-emperor-200 absolute right-0 bottom-0 h-[58%] w-[60%] overflow-hidden rounded-2xl border-4 border-white shadow-lg">
				<img src={hero2} alt={dict.finalCta.friendsImageAlt} loading="lazy" decoding="async" class="size-full object-cover" />
			</div>
		</div>

		<div class="md:pl-4">
			<h2 id="cta-heading" class="text-emperor-900 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
				{dict.finalCta.titleLine1}<br />{dict.finalCta.titleLine2}
			</h2>
			<p class="text-emperor-600 mt-4 max-w-md text-base">
				{dict.finalCta.description}
			</p>
			<a
				href={getRelativeLocaleUrl(locale, "/reservar")}
				class="hover:bg-emperor-800 mt-8 inline-flex items-center gap-2 rounded-full bg-black px-7 py-3 text-xs font-semibold tracking-wider text-white uppercase transition-colors"
			>
				{dict.finalCta.cta}
				<ArrowRight class="size-4" />
			</a>
		</div>
	</div>
</section>
