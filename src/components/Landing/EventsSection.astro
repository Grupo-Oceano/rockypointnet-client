---
import hero1 from "@assets/carousel-samples/hero-1.webp?url";
import hero2 from "@assets/carousel-samples/hero-2.webp?url";
import hero3 from "@assets/carousel-samples/hero-3.webp?url";
import hero5 from "@assets/carousel-samples/hero-5.webp?url";
import hero6 from "@assets/carousel-samples/hero-6.webp?url";
import { ArrowRight } from "@icons";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, resolveLocale, type Locale } from "../../locales";
import EventCard from "./EventCard.astro";

const locale: Locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);

const dateFormatter = new Intl.DateTimeFormat(locale, {
	weekday: "short",
	day: "numeric",
	month: "short",
	year: "numeric",
});
const sharedDate = dateFormatter.format(new Date(2026, 3, 9));

const events = [
	{
		title: dict.events.list.beachGathering.title,
		href: getRelativeLocaleUrl(locale, "/eventos/beach-gathering"),
		date: sharedDate,
		location: dict.events.sharedLocation,
		organizer: dict.events.sharedOrganizer,
		rating: 4.5,
		image: hero3,
		imageAlt: dict.events.list.beachGathering.imageAlt,
	},
	{
		title: dict.events.list.seafoodFestival.title,
		href: getRelativeLocaleUrl(locale, "/eventos/festival-mariscos"),
		date: sharedDate,
		location: dict.events.sharedLocation,
		organizer: dict.events.sharedOrganizer,
		rating: 4.5,
		image: hero2,
		imageAlt: dict.events.list.seafoodFestival.imageAlt,
	},
	{
		title: dict.events.list.communityEvents.title,
		href: getRelativeLocaleUrl(locale, "/eventos/community-events"),
		date: sharedDate,
		location: dict.events.sharedLocation,
		organizer: dict.events.sharedOrganizer,
		rating: 4.5,
		image: hero5,
		imageAlt: dict.events.list.communityEvents.imageAlt,
	},
	{
		title: dict.events.list.kayakSunset.title,
		href: getRelativeLocaleUrl(locale, "/eventos/kayak-sunset"),
		date: sharedDate,
		location: dict.events.sharedLocation,
		organizer: dict.events.sharedOrganizer,
		rating: 4.5,
		image: hero6,
		imageAlt: dict.events.list.kayakSunset.imageAlt,
	},
];
---

<section class="relative w-full overflow-hidden" aria-labelledby="events-heading">
	<div class="relative">
		<img src={hero1} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
		<div class="absolute inset-0 bg-linear-to-r from-black/75 via-black/45 to-black/15"></div>

		<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
			<div class="max-w-xl text-white">
				<h2 id="events-heading" class="text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
					{dict.events.headingLine1}<br />{dict.events.headingLine2}
				</h2>
				<p class="text-sand-100 mt-4 text-base sm:text-lg">
					{dict.events.subheading}
				</p>
			</div>
		</div>
	</div>

	<div class="bg-sand-50">
		<div class="mx-auto -mt-14 grid max-w-7xl grid-cols-1 gap-4 px-4 pb-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8 lg:pb-16">
			{
				events.map((e) => (
					<EventCard
						title={e.title}
						href={e.href}
						date={e.date}
						location={e.location}
						organizer={e.organizer}
						rating={e.rating}
						image={e.image}
						imageAlt={e.imageAlt}
					/>
				))
			}
		</div>

		<div class="pb-16 text-center">
			<a
				href={getRelativeLocaleUrl(locale, "/eventos")}
				class="hover:bg-emperor-800 inline-flex items-center gap-2 rounded-full bg-black px-6 py-3 text-xs font-semibold tracking-wider text-white uppercase transition-colors"
			>
				{dict.events.seeAll}
				<ArrowRight class="size-4" />
			</a>
		</div>
	</div>
</section>
