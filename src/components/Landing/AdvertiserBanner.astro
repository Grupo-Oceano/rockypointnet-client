---
import hero4 from "@assets/carousel-samples/hero-4.webp?url";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, resolveLocale } from "../../locales";

const locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);
---

<section class="mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 md:pb-16 lg:px-8" aria-label={dict.advertiser.sectionAria}>
	<div class="bg-emperor-900 relative overflow-hidden rounded-2xl shadow-sm">
		<img src={hero4} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover opacity-60" />
		<div class="absolute inset-0 bg-linear-to-r from-black/85 via-black/55 to-black/40"></div>

		<div class="relative grid gap-6 p-8 sm:p-10 md:grid-cols-2 md:p-12">
			<div class="text-white">
				<h2 class="text-2xl leading-tight font-bold tracking-tight sm:text-3xl">
					{dict.advertiser.title}
				</h2>
				<p class="text-sand-200 mt-2 max-w-md text-base sm:text-lg">
					{dict.advertiser.subtitle}
				</p>
				<a
					href={getRelativeLocaleUrl(locale, "/anunciate")}
					class="text-emperor-900 hover:bg-sand-100 mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-2.5 text-sm font-semibold transition-colors"
				>
					{dict.advertiser.cta}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-4"
						aria-hidden="true"
					>
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
			</div>

			<div class="grid place-items-center rounded-xl border border-dashed border-white/30 px-6 py-10 text-sm text-white/70" aria-hidden="true">
				{dict.advertiser.placeholder}
			</div>
		</div>
	</div>
</section>
