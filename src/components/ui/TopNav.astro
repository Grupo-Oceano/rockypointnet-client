---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, resolveLocale } from "../../locales";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import Logo from "./Logo.astro";
import { Bed, Utensils, Binoculars, FerrisWheel, Ticket, Menu, X } from "@icons";

const locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);

const navItems = [
	{
		href: getRelativeLocaleUrl(locale, "/hotels"),
		label: dict.nav.items.hotels,
		icon: Bed,
	},
	{
		href: getRelativeLocaleUrl(locale, "/restaurants"),
		label: dict.nav.items.restaurants,
		icon: Utensils,
	},
	{
		href: getRelativeLocaleUrl(locale, "/activities"),
		label: dict.nav.items.activities,
		icon: Binoculars,
	},
	{
		href: getRelativeLocaleUrl(locale, "/attractions"),
		label: dict.nav.items.attractions,
		icon: FerrisWheel,
	},
	{
		href: getRelativeLocaleUrl(locale, "/events"),
		label: dict.nav.items.events,
		icon: Ticket,
	},
] as const;
---

<header
	class="bg-sand-50 supports-backdrop-filter:bg-sand-50/80 sticky top-0 z-40 w-full backdrop-blur"
	data-topnav
	data-open-label={dict.nav.openMenuAria}
	data-close-label={dict.nav.closeMenuAria}
>
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 py-12 sm:px-6 lg:px-8" aria-label={dict.nav.primaryAria}>
		<Logo className="w-32" />

		<ul class="hidden items-center gap-1 sm:flex sm:gap-6">
			{
				navItems.map((item) => (
					<li>
						<a
							href={item.href}
							class="group text-emperor-700 hover:bg-sand-100 hover:text-emperor-900 inline-flex items-center gap-2.5 rounded-full px-3 py-2 text-sm font-light transition-colors"
						>
							<item.icon class="h-4 w-4" stroke-width={2} />
							<span>{item.label}</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden sm:block">
			<LocaleSwitcher className="w-32" />
		</div>

		<button
			type="button"
			class="text-emperor-700 hover:bg-sand-100 hover:text-emperor-900 inline-flex items-center justify-center rounded-full p-2 transition-colors sm:hidden"
			aria-controls="topnav-mobile-panel"
			aria-expanded="false"
			aria-label={dict.nav.openMenuAria}
			data-mobile-toggle
		>
			<Menu class="block h-5 w-5" data-icon-open stroke-width={2} />
			<X class="hidden h-5 w-5" data-icon-close stroke-width={2} />
		</button>
	</nav>

	<div id="topnav-mobile-panel" class="border-sand-200 bg-sand-50 hidden border-t sm:hidden" data-mobile-panel>
		<ul class="flex flex-col gap-1 px-4 py-3">
			{
				navItems.map((item) => (
					<li>
						<a
							href={item.href}
							class="group text-emperor-700 hover:bg-sand-100 hover:text-emperor-900 inline-flex w-full items-center gap-3 rounded-full px-3 py-2 text-sm font-light transition-colors"
						>
							<item.icon class="h-4 w-4" stroke-width={2} />
							<span>{item.label}</span>
						</a>
					</li>
				))
			}
			<li class="mt-2">
				<LocaleSwitcher />
			</li>
		</ul>
	</div>
</header>

<script>
	function initTopNav() {
		const header = document.querySelector<HTMLElement>("[data-topnav]");
		if (!header || header.dataset.topnavBound === "true") return;
		header.dataset.topnavBound = "true";

		const toggle = header.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
		const panel = header.querySelector<HTMLElement>("[data-mobile-panel]");
		const openIcon = header.querySelector<HTMLElement>("[data-icon-open]");
		const closeIcon = header.querySelector<HTMLElement>("[data-icon-close]");
		const openLabel = header.dataset.openLabel ?? "Open navigation menu";
		const closeLabel = header.dataset.closeLabel ?? "Close navigation menu";

		const setOpen = (open: boolean) => {
			if (!toggle || !panel || !openIcon || !closeIcon) return;
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
			panel.classList.toggle("hidden", !open);
			openIcon.classList.toggle("hidden", open);
			openIcon.classList.toggle("block", !open);
			closeIcon.classList.toggle("hidden", !open);
			closeIcon.classList.toggle("block", open);
		};

		toggle?.addEventListener("click", () => {
			const isOpen = toggle.getAttribute("aria-expanded") === "true";
			setOpen(!isOpen);
		});

		panel?.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
				setOpen(false);
				toggle.focus();
			}
		});

		const scrollHandler = () => {
			if (window.scrollY > 20) header.classList.add("shadow-lg");
			else header.classList.remove("shadow-lg");
		};
		window.addEventListener("scroll", scrollHandler, { passive: true });
		scrollHandler();
	}

	initTopNav();
	document.addEventListener("astro:page-load", initTopNav);
</script>
