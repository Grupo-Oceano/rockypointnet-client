---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, resolveLocale } from "../../locales";

const year = new Date().getFullYear();
const locale = resolveLocale(Astro.currentLocale);
const dict = getDictionary(locale);

const primaryLinks = [
	{ href: getRelativeLocaleUrl(locale, "/privacidad"), label: dict.footer.primary.privacy },
	{ href: getRelativeLocaleUrl(locale, "/terminos"), label: dict.footer.primary.terms },
	{ href: getRelativeLocaleUrl(locale, "/preferencias"), label: dict.footer.primary.preferences },
];

const secondaryLinks = [
	{ href: getRelativeLocaleUrl(locale, "/sugerir-restaurante"), label: dict.footer.secondary.suggestRestaurant },
	{ href: getRelativeLocaleUrl(locale, "/anunciate"), label: dict.footer.secondary.advertise },
	{ href: getRelativeLocaleUrl(locale, "/nosotros"), label: dict.footer.secondary.about },
	{ href: getRelativeLocaleUrl(locale, "/contacto"), label: dict.footer.secondary.contact },
];
---

<footer class="bg-black text-white">
	<div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-6 text-sm sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
		<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6">
			<span class="text-white/70">{dict.footer.copyright(year)}</span>
			<ul class="flex flex-wrap gap-x-6 gap-y-2">
				{
					primaryLinks.map((l) => (
						<li>
							<a href={l.href} class="text-white/70 transition-colors hover:text-white">
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<ul class="flex flex-wrap gap-x-6 gap-y-2">
			{
				secondaryLinks.map((l) => (
					<li>
						<a href={l.href} class="text-white/70 transition-colors hover:text-white">
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
