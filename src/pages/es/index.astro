---
import AdvertiserBanner from "@components/Landing/AdvertiserBanner.astro";
import EventsSection from "@components/Landing/EventsSection.astro";
import ExploraGrid from "@components/Landing/ExploraGrid.astro";
import FinalCTA from "@components/Landing/FinalCTA.astro";
import Hero from "@components/Landing/Hero.astro";
import SearchWidget from "@components/qwik/landing/SearchWidget";
import Footer from "@components/ui/Footer.astro";
import TopNav from "@components/ui/TopNav.astro";
import Layout from "@layouts/Layout.astro";
import { resolveLocale } from "@locales";

const locale = resolveLocale(Astro.currentLocale);
---

<Layout>
	<TopNav />
	<main>
		<Hero />
		<SearchWidget locale={locale} />
		<ExploraGrid />
		<AdvertiserBanner />
		<EventsSection />
		<FinalCTA />
	</main>
	<Footer />
</Layout>
